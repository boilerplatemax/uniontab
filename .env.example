# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
# IMPORTANT: For Vercel deployment, use Transaction Mode pooling (port 6543)
# Example formats:
#   Supabase Transaction Mode: postgres://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:6543/postgres
#   Supabase Session Mode: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
#   Neon: postgresql://[user]:[password]@[project].pooler.neon.tech/[db]?sslmode=require
# Note: This project uses prepared statements disabled (prepare: false) for Transaction Mode compatibility
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***
TEST_URL=https://example.com

# Supabase (for file storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SendGrid (for email notifications)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key
# IMPORTANT: This email MUST be verified in SendGrid before sending emails
# Verify at: https://app.sendgrid.com/settings/sender_auth
# You can use Single Sender Verification or Domain Authentication
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=UnionTab

# Cloudflare (for automatic DNS record management)
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone.DNS (Edit)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Get Zone ID from your domain's overview page in Cloudflare dashboard
CLOUDFLARE_ZONE_ID=your-zone-id

# Email Domain Configuration
# Base domain for tenant subdomains (e.g., uniontab.com)
# Each tenant will get a subdomain like: atu123.uniontab.com
EMAIL_BASE_DOMAIN=uniontab.com